{
  "name": "mitchell-working-tool",
  "productName": "Mitchell's Working Tool",
  "private": true,
  "version": "0.13.0",
  "main": "desktop/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test tests/*.test.mjs",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "preview": "vite preview",
    "icon": "node scripts/apply-avatar.mjs assets/avatar.png",
    "desktop": "npm run build && electron desktop/main.mjs",
    "desktop:only": "electron desktop/main.mjs"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.5",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}

